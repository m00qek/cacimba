config tinyauth 'main'
	option enabled '1'

	# Required: the URL tinyauth is reached at, through the reverse proxy.
	# A domain, not an IP address: its cookies are scoped to it.
	#option app_url 'https://auth.example.com'

	# Loopback: the reverse proxy is the way in, so its auth cannot be
	# bypassed by reaching the port directly. Upstream listens everywhere.
	option address '127.0.0.1'
	option port '3000'

	# Its state: the session database, its OIDC signing keys and its
	# resources. In RAM (the default) a reboot only signs everyone out;
	# if tinyauth is itself an OIDC provider, use persistent storage, so
	# its keys survive.
	option data_dir '/var/lib/tinyauth'

	# trace, debug, info, warn or error.
	option log_level 'info'

	# Upstream reports its version home periodically.
	option analytics '0'

	# The Go runtime's soft limit, absolute: a router has no swap.
	option gomemlimit '64MiB'

	# Every other tinyauth setting, as its environment variable, one per
	# entry: https://tinyauth.app/docs/ . Values may contain spaces. Keep
	# secrets in files in /etc/tinyauth (readable by the tinyauth group) and
	# point the *FILE settings at them: its jail sees that directory.
	#list env 'TINYAUTH_AUTH_SECURECOOKIE=true'
	#list env 'TINYAUTH_AUTH_TRUSTEDPROXIES=127.0.0.1'
	#list env 'TINYAUTH_OAUTH_AUTOREDIRECT=pocketid'
	#list env 'TINYAUTH_OAUTH_PROVIDERS_POCKETID_NAME=Pocket ID'
	#list env 'TINYAUTH_OAUTH_PROVIDERS_POCKETID_CLIENTID=00000000-0000-0000-0000-000000000000'
	#list env 'TINYAUTH_OAUTH_PROVIDERS_POCKETID_CLIENTSECRETFILE=/etc/tinyauth/pocketid-client-secret'
	#list env 'TINYAUTH_OAUTH_PROVIDERS_POCKETID_SCOPES=openid email profile'
	#list env 'TINYAUTH_OAUTH_PROVIDERS_POCKETID_AUTHURL=https://id.example.com/authorize'
	#list env 'TINYAUTH_OAUTH_PROVIDERS_POCKETID_TOKENURL=https://id.example.com/api/oidc/token'
	#list env 'TINYAUTH_OAUTH_PROVIDERS_POCKETID_USERINFOURL=https://id.example.com/api/oidc/userinfo'

	# Other paths it needs in its jail:
	#list jail_mount '/some/file'
	#list jail_mount_rw '/some/dir'
