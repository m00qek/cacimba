#!/bin/sh /etc/rc.common
# tinyauth: a login page in front of web apps, for a reverse proxy's
# forward auth. Configured in /etc/config/tinyauth, which becomes its
# environment: tinyauth reads its settings from TINYAUTH_* variables.

USE_PROCD=1
START=96
STOP=10

PROG=/usr/bin/tinyauth
NAME=tinyauth
SECRETS=/etc/tinyauth

# The variables the service sets from its own options: an `env` entry for
# one of them would contradict an option, so it is refused.
OWNED="TINYAUTH_APPURL TINYAUTH_SERVER_ADDRESS TINYAUTH_SERVER_PORT \
TINYAUTH_DATABASE_PATH TINYAUTH_RESOURCES_PATH TINYAUTH_OIDC_PRIVATEKEYPATH \
TINYAUTH_OIDC_PUBLICKEYPATH TINYAUTH_LOG_LEVEL TINYAUTH_ANALYTICS_ENABLED \
TINYAUTH_LABELPROVIDER TINYAUTH_CONFIGFILE"

# The options, their types and defaults, in one place: start_service reads
# them through this, and `ubus call service validate` reports bad values.
validate_tinyauth_section() {
	uci_load_validate tinyauth tinyauth "$1" "$2" \
		'enabled:bool:1' \
		'app_url:string' \
		'address:string:127.0.0.1' \
		'port:port:3000' \
		'data_dir:string:/var/lib/tinyauth' \
		'log_level:or("trace", "debug", "info", "warn", "error"):info' \
		'analytics:bool:0' \
		'gomemlimit:string:64MiB' \
		'env:list(string)' \
		'jail_mount:list(string)' \
		'jail_mount_rw:list(string)'
}

# mount_missing DIR: DIR is under a mount point /etc/config/fstab declares,
# and that mount is not mounted yet.
mount_missing() {
	local target
	for target in $(procd_get_mountpoints "$1"); do
		grep -q " $target " /proc/mounts || return 0
	done
	return 1
}

# check_env ENTRY: an `env` entry is NAME=VALUE, NAME a TINYAUTH_ variable
# the service does not set itself. Sets env_bad otherwise.
check_env() {
	local name="${1%%=*}"
	case "$1" in
		TINYAUTH_*=*) ;;
		*) echo "$NAME: env entry '$name' is not TINYAUTH_<SETTING>=<value>" >&2; env_bad=1; return ;;
	esac
	case " $OWNED " in
		*" $name "*) echo "$NAME: env entry $name is set from an option of /etc/config/$NAME" >&2; env_bad=1 ;;
	esac
}

# add_env ENTRY: one `env` entry, whole: values may contain spaces, which
# the validated list would split.
add_env() {
	procd_append_param env "$1"
}

start_tinyauth() {
	local arg env_bad= analytics_enabled=false

	if [ "$2" != 0 ]; then
		echo "$NAME: invalid configuration in /etc/config/$NAME, not starting" >&2
		return 1
	fi
	[ "$enabled" = 1 ] || return 0

	# Without it tinyauth fails at startup with a bare "invalid url".
	if [ -z "$app_url" ]; then
		echo "$NAME: no app_url in /etc/config/$NAME, not starting" >&2
		return 1
	fi
	config_load tinyauth
	config_list_foreach main env check_env
	if [ -n "$env_bad" ]; then
		echo "$NAME: invalid configuration in /etc/config/$NAME, not starting" >&2
		return 1
	fi
	# Its state on storage that is not mounted yet would land on the
	# overlay. service_triggers starts it when the mount appears.
	if mount_missing "$data_dir"; then
		echo "$NAME: $data_dir is not mounted yet, waiting for it" >&2
		return 0
	fi

	mkdir -p "$data_dir"
	# Handed over once, when it is not its own yet.
	[ "$(ls -ld "$data_dir" | awk '{print $3}')" = $NAME ] ||
		chown -R "$NAME:$NAME" "$data_dir"
	[ "$analytics" = 1 ] && analytics_enabled=true

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param env \
		TINYAUTH_APPURL="$app_url" \
		TINYAUTH_SERVER_ADDRESS="$address" \
		TINYAUTH_SERVER_PORT="$port" \
		TINYAUTH_DATABASE_PATH="$data_dir/tinyauth.db" \
		TINYAUTH_RESOURCES_PATH="$data_dir/resources" \
		TINYAUTH_OIDC_PRIVATEKEYPATH="$data_dir/tinyauth_oidc_key" \
		TINYAUTH_OIDC_PUBLICKEYPATH="$data_dir/tinyauth_oidc_key.pub" \
		TINYAUTH_LOG_LEVEL="$log_level" \
		TINYAUTH_ANALYTICS_ENABLED="$analytics_enabled" \
		TINYAUTH_LABELPROVIDER=none \
		NO_COLOR=1
	[ -n "$gomemlimit" ] && procd_append_param env GOMEMLIMIT="$gomemlimit"
	config_list_foreach main env add_env

	# Its own mount namespace: its secret files read-only, data_dir
	# writable, and what it needs to reach OAuth, OIDC or LDAP servers by
	# name over TLS.
	procd_add_jail "$NAME" log procfs requirejail
	procd_add_jail_mount "$SECRETS" /etc/ssl/certs /etc/hosts
	# The jail is required, so a path that does not exist must not be in it.
	for arg in /etc/resolv.conf /tmp/resolv.conf /tmp/resolv.conf.d; do
		[ -e "$arg" ] && procd_add_jail_mount "$arg"
	done
	procd_add_jail_mount_rw "$data_dir"
	for arg in $jail_mount; do
		procd_add_jail_mount "$arg"
	done
	for arg in $jail_mount_rw; do
		procd_add_jail_mount_rw "$arg"
	done

	procd_set_param user "$NAME"
	procd_set_param group "$NAME"
	procd_set_param no_new_privs 1
	procd_set_param term_timeout 15
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

start_service() {
	validate_tinyauth_section main start_tinyauth
}

service_triggers() {
	local data_dir

	procd_add_reload_trigger tinyauth

	config_load tinyauth
	config_get data_dir main data_dir /var/lib/tinyauth
	procd_add_restart_mount_trigger "$data_dir"

	procd_add_validation validate_tinyauth_section
}
