config vmagent 'main'
	option enabled '1'

	# What to scrape: a Prometheus scrape configuration.
	option config '/etc/vmagent/scrape.yml'

	# Where samples queue while a remote_write target is unreachable. /var is
	# RAM on OpenWrt: point this at persistent storage to keep the queue
	# across reboots, and raise max_disk_per_url with it.
	option data_dir '/var/lib/vmagent'
	option max_disk_per_url '16MB'

	# Its own metrics and API. Loopback only by default.
	option listen '127.0.0.1:8429'

	# Where to write, one or more. Each gets its own queue, so one being
	# unreachable does not hold back the others. Required: vmagent does not
	# start without one.
	#list remote_write 'http://127.0.0.1:8428/api/v1/write'

	# Labels added to every sample written.
	#list label 'site=home'

	# Memory: vmagent's cache budget, and the Go runtime's soft limit. Both
	# absolute: vmagent's own default is 60% of RAM, and a router has no
	# swap to absorb that.
	option memory_allowed '32MB'
	option gomemlimit '64MiB'

	# INFO, WARN or ERROR. logd keeps a small buffer: an unreachable target
	# logs on every scrape, and -promscrape.suppressScrapeErrors (extra_args)
	# silences those alone.
	option log_level 'INFO'

	# Any other vmagent flag, one per entry, without spaces.
	#list extra_args '-promscrape.suppressScrapeErrors'

	# It runs in a jail that sees only its config, data_dir, the CA bundle
	# and the resolver files. Other files the scrape config refers to:
	#list jail_mount '/etc/vmagent/ca.pem'
	#list jail_mount_rw '/some/dir'
