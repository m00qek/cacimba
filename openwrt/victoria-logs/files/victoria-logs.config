config victoria-logs 'main'
	option enabled '1'

	# Where the database lives. Required: it does not start without one.
	# Use persistent storage (a USB disk, an SD card): /tmp and /var are
	# RAM on OpenWrt, and flash wears out under a database's writes.
	#option data_dir '/mnt/data/victoria-logs'

	# How long logs are kept: h, d, w, y suffixes (30d, 12w, 1y).
	option retention '7d'

	# Its HTTP API: log ingestion, LogsQL queries, its own metrics. Loopback only by
	# default; it has no authentication of its own.
	option listen '127.0.0.1:9428'

	# Memory: its cache budget, and the Go runtime's soft limit. Both
	# absolute: its own default is 60% of RAM, and a router has no swap.
	option memory_allowed '64MB'
	option gomemlimit '128MiB'

	# INFO, WARN or ERROR.
	option log_level 'INFO'

	# Any other victoria-logs flag, one per entry, without spaces.
	#list extra_args '-syslog.timezone=America/Sao_Paulo'

	# It runs in a jail that sees only data_dir. Other paths it needs:
	#list jail_mount '/some/file'
	#list jail_mount_rw '/some/dir'

# A syslog input: where to listen, and the tenant (AccountID:ProjectID) its
# logs are stored under. One section per input. A port below 1024 needs root,
# which it does not run as: use 1024 or above, and forward to it if needed.
#config syslog
#	option proto 'tcp'
#	option listen '127.0.0.1:1514'
#	option tenant '0:0'
