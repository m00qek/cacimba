config perses 'main'
	option enabled '1'

	# Required: its database (dashboards, datasources, users) and the
	# plugins it unpacks, ~11MB each. Persistent storage, not flash: a USB
	# disk or SD card.
	#option data_dir '/mnt/data/perses'

	# Loopback: a reverse proxy is the way in. Upstream listens everywhere.
	option listen '127.0.0.1:8080'

	# panic, fatal, error, warning, info, debug or trace.
	option log_level 'info'

	# The Go runtime's soft limit, absolute: a router has no swap.
	option gomemlimit '256MiB'

	# Encrypts the secrets of datasources in its database. Made on the
	# first start if missing; changing it makes those unreadable.
	option encryption_key_file '/etc/perses/encryption-key'

	# Logins. Without them anyone who reaches it can edit everything.
	option auth '0'
	# Perses' own accounts, besides any oidc providers below.
	option native_login '1'
	# What a user may do before being granted a role, with auth on.
	#list guest_action 'read'
	#list guest_scope '*'

	# The Explore view (needs the LogExplorer plugin for logs).
	option explorer '0'

	# Folders of resources (projects, dashboards, datasources) it loads at
	# start and again every provisioning_interval. A file overwrites edits
	# made in the UI; removing a file does not remove what it made.
	list provisioning '/etc/perses/provisioning'
	option provisioning_interval '1h'

	# Every other Perses setting, as its environment variable, one per
	# entry: PERSES_ and the path of the setting in its configuration file,
	# https://perses.dev/perses/docs/configuration/configuration/ .
	#list env 'PERSES_SECURITY_COOKIE_SECURE=true'

	# Other paths it needs in its jail:
	#list jail_mount '/some/file'
	#list jail_mount_rw '/some/dir'

# One per OpenID Connect provider. Its callback, to register with it:
# <public URL>/api/auth/providers/oidc/<slug_id>/callback
#config oidc
#	option slug_id 'pocketid'
#	option name 'Pocket ID'
#	option issuer 'https://id.example.com'
#	option client_id '00000000-0000-0000-0000-000000000000'
#	# A file in /etc/perses, readable by the perses group.
#	option client_secret_file '/etc/perses/pocketid-client-secret'
#	list scope 'openid'
#	list scope 'profile'
#	list scope 'email'
#	option disable_pkce '0'
